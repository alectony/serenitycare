{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.3",
      "includeFiles": "*.php|includes/**|admin/**|counselor/**|patient/**|public/**"
    }
  },
  "routes": [
    { "src": "^/css/(.*)$", "dest": "/public/css/$1" },
    { "src": "^/js/(.*)$", "dest": "/public/js/$1" },
    { "handle": "filesystem" },
    { "src": "^/(.*)$", "dest": "/api/index.php" }
  ]
}